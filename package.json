{
  "name": "uppies",
  "private": true,
  "scripts": {
    "dev": "concurrently -n worker,app -c cyan,magenta \"pnpm --filter worker dev\" \"pnpm --filter app dev\"",
    "build": "pnpm --filter tokens build && pnpm --filter app build",
    "tokens": "pnpm --filter tokens build",
    "deploy": "pnpm build && pnpm --filter worker deploy",
    "seed": "tsx scripts/seed.ts",
    "seed:remote": "tsx scripts/seed.ts --remote"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@bundled-es-modules/glob",
      "esbuild",
      "style-dictionary",
      "workerd"
    ],
    "overrides": {
      "@fastify/busboy": ">=3.2.2",
      "@vitest/mocker": ">=4.1.12",
      "brace-expansion": ">=2.1.7",
      "devalue": ">=5.9.3",
      "esbuild": ">=0.28.1",
      "glob": ">=14.0.2",
      "minimatch": ">=11.0.1",
      "nanoid": ">=3.3.18",
      "node-forge": ">=1.4.1",
      "postcss": ">=8.5.23",
      "qs": ">=6.16.1",
      "sharp": ">=0.35.5",
      "shell-quote": ">=1.9.0",
      "source-map-js": ">=1.2.2",
      "tinypool": ">=2.1.2",
      "tmp": ">=0.2.6",
      "undici": ">=7.30.1",
      "ws": ">=8.21.0",
      "zod": ">=4.6.6"
    }
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.0",
    "concurrently": "^9.2.1",
    "js-yaml": "^4.3.2",
    "tsx": "^4.23.15"
  }
}
